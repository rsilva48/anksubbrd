    "Cambiar el token te convierte en otro usuario. El historial y las preferencias actuales seguirán en el servidor, pero este iPhone o iPad no podrá abrirlos de nuevo sin el token actual." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the token makes you a different user. The current history and preferences stay on the server, but this iPhone or iPad won't be able to open them again without the current token."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el token te convierte en otro usuario. El historial y las preferencias actuales seguirán en el servidor, pero este iPhone o iPad no podrá abrirlos de nuevo sin el token actual."
          }
        }
      }
    },
